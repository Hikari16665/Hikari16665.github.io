<div class="route-transition" data-route-transition transition:persist="route-transition" aria-hidden="true">
  <span class="route-glitch route-glitch--one"></span>
  <span class="route-glitch route-glitch--two"></span>
  <span class="route-glitch route-glitch--three"></span>
  <span class="route-glitch route-glitch--four"></span>
  <span class="route-glitch route-glitch--five"></span>
</div>

<script>
  import type { TransitionBeforePreparationEvent } from 'astro:transitions/client';

  type TransitionState = {
    x: number;
    y: number;
    covered: boolean;
    animation: Animation | null;
  };

  const overlay = () => document.querySelector<HTMLElement>('[data-route-transition]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const supportsAnimation = typeof Element.prototype.animate === 'function';
  const supportsMask = CSS.supports('mask-image', 'radial-gradient(circle, #000, transparent)')
    || CSS.supports('-webkit-mask-image', 'radial-gradient(circle, #000, transparent)');
  const state: TransitionState = {
    x: window.innerWidth / 2,
    y: window.innerHeight / 2,
    covered: false,
    animation: null,
  };

  const radiusFor = (x: number, y: number) => Math.hypot(
    Math.max(x, window.innerWidth - x),
    Math.max(y, window.innerHeight - y),
  );

  const setOriginFromLink = (link: HTMLAnchorElement, event?: MouseEvent) => {
    if (event && event.detail > 0) {
      state.x = event.clientX;
      state.y = event.clientY;
      return;
    }
    const rect = link.getBoundingClientRect();
    state.x = rect.left + rect.width / 2;
    state.y = rect.top + rect.height / 2;
  };

  const isRoutedLink = (link: HTMLAnchorElement, event: MouseEvent) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
    if (link.target && link.target !== '_self') return false;
    if (link.hasAttribute('download') || link.hasAttribute('data-astro-reload')) return false;
    const url = new URL(link.href, window.location.href);
    if (url.origin !== window.location.origin) return false;
    return url.pathname !== window.location.pathname || url.search !== window.location.search;
  };

  document.addEventListener('click', (event) => {
    const mouseEvent = event as MouseEvent;
    const target = mouseEvent.target as Element | null;
    const link = target?.closest<HTMLAnchorElement>('a[href]');
    if (!link || !isRoutedLink(link, mouseEvent)) return;
    setOriginFromLink(link, mouseEvent);
  }, { capture: true });

  const animateOverlay = async (cover: boolean) => {
    const element = overlay();
    if (!element || reduceMotion.matches || !supportsAnimation || !supportsMask) {
      state.covered = cover;
      return;
    }

    state.animation?.cancel();
    const radius = radiusFor(state.x, state.y) + 2;
    document.documentElement.dataset.routeTransition = 'running';
    element.style.visibility = 'visible';
    element.dataset.phase = cover ? 'cover' : 'reveal';
    element.style.setProperty('--route-x', `${state.x}px`);
    element.style.setProperty('--route-y', `${state.y}px`);
    element.style.setProperty('--route-radius', '0px');

    state.animation = element.animate(
      [{ '--route-radius': '0px' }, { '--route-radius': `${radius}px` }],
      {
        duration: cover ? 560 : 720,
        easing: cover ? 'cubic-bezier(.76, 0, .24, 1)' : 'cubic-bezier(.16, 1, .3, 1)',
        fill: 'forwards',
      },
    );

    try {
      await state.animation.finished;
    } catch {
      // A newer navigation animation superseded this one.
    }
    state.covered = cover;
    element.style.setProperty('--route-radius', `${radius}px`);
    if (!cover) {
      element.style.visibility = 'hidden';
      delete element.dataset.phase;
      delete document.documentElement.dataset.routeTransition;
    }
  };

  document.addEventListener('astro:before-preparation', (rawEvent) => {
    const event = rawEvent as TransitionBeforePreparationEvent;
    const originalLoader = event.loader;
    event.loader = async () => {
      await animateOverlay(true);
      try {
        await originalLoader();
      } catch (error) {
        await animateOverlay(false);
        throw error;
      }
    };
  });

  document.addEventListener('astro:after-swap', () => {
    if (!state.covered) return;
    requestAnimationFrame(() => requestAnimationFrame(() => void animateOverlay(false)));
  });
</script>

<style>
  @property --route-radius {
    syntax: '<length>';
    inherits: false;
    initial-value: 0px;
  }

  .route-transition {
    --route-x: 50vw;
    --route-y: 50vh;
    --route-radius: 0px;
    position: fixed;
    z-index: 2147483646;
    inset: 0;
    visibility: hidden;
    background: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
    will-change: mask-image, -webkit-mask-image;
  }

  .route-transition[data-phase='cover'] {
    -webkit-mask-image: radial-gradient(circle at var(--route-x) var(--route-y), #000 0 var(--route-radius), transparent calc(var(--route-radius) + 1px));
    mask-image: radial-gradient(circle at var(--route-x) var(--route-y), #000 0 var(--route-radius), transparent calc(var(--route-radius) + 1px));
  }

  .route-transition[data-phase='reveal'] {
    -webkit-mask-image: radial-gradient(circle at var(--route-x) var(--route-y), transparent 0 var(--route-radius), #000 calc(var(--route-radius) + 1px));
    mask-image: radial-gradient(circle at var(--route-x) var(--route-y), transparent 0 var(--route-radius), #000 calc(var(--route-radius) + 1px));
  }

  .route-transition::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, transparent 0 5px, rgba(0, 0, 0, .16) 6px, transparent 7px);
    opacity: 0;
    pointer-events: none;
  }

  .route-transition::after {
    content: '';
    position: absolute;
    top: 42%;
    left: 12%;
    width: 4.5rem;
    height: 9px;
    background: rgba(0, 0, 0, .52);
    box-shadow: 31vw 17vh 0 rgba(0, 0, 0, .36), 68vw -23vh 0 rgba(0, 0, 0, .28);
    opacity: 0;
    pointer-events: none;
  }

  .route-transition[data-phase]::before { animation: route-scan-noise 780ms steps(3, end) 1; }
  .route-transition[data-phase]::after { animation: route-data-blocks 620ms steps(2, end) 110ms 1; }

  .route-glitch {
    position: absolute;
    left: -8vw;
    width: 116vw;
    height: 1px;
    background: rgba(0, 0, 0, 0.58);
    box-shadow: 0 0 8px rgba(0, 0, 0, 0.22);
    opacity: 0;
    transform: translateX(0);
  }

  .route-glitch--one { top: 19%; height: 2px; }
  .route-glitch--two { top: 37%; left: 6vw; width: 68vw; height: 6px; }
  .route-glitch--three { top: 56%; height: 2px; }
  .route-glitch--four { top: 69%; left: 34vw; width: 72vw; height: 9px; }
  .route-glitch--five { top: 84%; left: -4vw; width: 82vw; height: 3px; }

  .route-transition[data-phase] .route-glitch--one { animation: route-glitch-shift 520ms steps(2, end) 70ms 1; }
  .route-transition[data-phase] .route-glitch--two { animation: route-glitch-shift 670ms steps(2, end) 150ms 1 reverse; }
  .route-transition[data-phase] .route-glitch--three { animation: route-glitch-shift 480ms steps(2, end) 270ms 1; }
  .route-transition[data-phase] .route-glitch--four { animation: route-glitch-shift 610ms steps(2, end) 210ms 1 reverse; }
  .route-transition[data-phase] .route-glitch--five { animation: route-glitch-shift 460ms steps(2, end) 390ms 1; }

  @keyframes route-glitch-shift {
    0%, 34%, 100% { opacity: 0; transform: translateX(0); }
    35%, 52% { opacity: .72; transform: translateX(2.4vw); }
    53%, 68% { opacity: .38; transform: translateX(-1.3vw); }
    69%, 99% { opacity: 0; transform: translateX(0); }
  }

  @keyframes route-scan-noise {
    0%, 100% { opacity: 0; transform: translateY(0); }
    24% { opacity: .2; transform: translateY(2px); }
    48% { opacity: .1; transform: translateY(-1px); }
    72% { opacity: .16; transform: translateY(1px); }
  }

  @keyframes route-data-blocks {
    0%, 28%, 100% { opacity: 0; transform: translateX(0); }
    29%, 55% { opacity: .72; transform: translateX(1.8vw); }
    56%, 76% { opacity: .34; transform: translateX(-1vw); }
    77%, 99% { opacity: 0; }
  }

  :global(html[data-route-transition='running']) {
    cursor: progress;
  }

  :global(html[data-route-transition='running'] body) {
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .route-transition { display: none; }
    .route-glitch { animation: none !important; }
    .route-transition::before, .route-transition::after { animation: none !important; }
  }
</style>
